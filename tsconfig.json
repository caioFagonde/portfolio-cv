{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "caio-portfolio",
    "caio-portfolio/**",
    "artifacts",
    "artifacts/**",
    ".vercel",
    ".netlify",
    ".output"
  ]
}
