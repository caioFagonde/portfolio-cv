---
import { sitePath } from '@/utils/paths';
import DomainPill from './DomainPill.astro';
const { entry } = Astro.props;
const { data, slug } = entry;
---
<a href={sitePath(`/cases/${slug}`)} class="atlas-card group block p-6 transition duration-200 hover:border-steel-500/50">
  <div class="flex items-center justify-between gap-4">
    <p class="kicker">Case study</p>
    <span class="font-mono text-xs text-ink-600">{data.year}</span>
  </div>
  <h3 class="mt-5 font-serif text-3xl leading-[1.02] text-ink-900 group-hover:text-copper-700">{data.title}</h3>
  <p class="mt-4 text-sm leading-7 text-ink-600">{data.summary}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {data.domains.slice(0, 2).map((d: string) => <DomainPill id={d} />)}
  </div>
  <div class="mt-7 border-t hairline pt-4 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-copper-700">Read case -></div>
</a>
