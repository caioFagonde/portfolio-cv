---
import { sitePath } from '@/utils/paths';
import { profile } from '@/data/cv';
---
<footer class="site-footer">
  <div class="container-atlas footer-top">
    <div>
      <p class="kicker">Have a project in mind?</p>
      <h2>Let’s talk.</h2>
      <a class="footer-email" href={sitePath(`mailto:${profile.email}`)}>{profile.email} <span aria-hidden="true">↗</span></a>
      <p class="footer-note">Software development, cloud infrastructure,<br />AI agents, and chatbots. Based in Brazil.</p>
    </div>
    <div class="footer-links">
      <div><p class="kicker">Explore</p><a href={sitePath('/projects')}>Projects</a><a href={sitePath('/cases')}>Case studies</a><a href={sitePath('/research')}>Research</a><a href={sitePath('/demos')}>Demos & experiments</a></div>
      <div><p class="kicker">Work together</p><a href={sitePath('/ai-systems')}>AI flows & chatbots</a><a href={sitePath('/consulting')}>Consulting</a><a href={sitePath('/workflow')}>Engineering workflow</a><a href={sitePath('/repo-audit')}>Codebase audit</a></div>
      <div><p class="kicker">Elsewhere</p><a href={sitePath('/about')}>About</a><a href={sitePath('/cv')}>CV</a><a href="https://github.com/caioFagonde" target="_blank" rel="noreferrer">GitHub ↗</a><a href={sitePath('/contact')}>Contact</a></div>
    </div>
  </div>
  <div class="container-atlas footer-bottom"><span>© {new Date().getFullYear()} Caio Nahuel Sousa Fagonde</span><span>Software · Cloud · AI</span></div>
</footer>
