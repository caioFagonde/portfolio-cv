---
import { sitePath } from '@/utils/paths';
import { localeFromPath, localePath, withoutLocalePath } from '@/i18n/locale';
const nav = [
  ['Projects', '/projects'],
  ['AI systems', '/ai-systems'],
  ['Consulting', '/consulting'],
  ['Skills', '/skills'],
  ['About', '/about']
];
const current = withoutLocalePath(Astro.url.pathname);
const locale = localeFromPath(Astro.url.pathname);
---
<header class="site-header">
  <div class="container-atlas header-inner">
    <a href={sitePath('/')} class="site-brand" aria-label="Caio Nahuel — home">
      <span class="brand-mark" aria-hidden="true">cn<span>.</span></span>
      <span class="brand-name">Caio Nahuel<span>Software · Cloud · AI</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu <span aria-hidden="true">＋</span></button>
    <nav id="primary-nav" aria-label="Main navigation">
      {nav.map(([label, href]) => <a href={sitePath(href)} aria-current={current.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      <a href={sitePath('/contact')} class="header-contact">Let’s talk <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="language-switch" data-language-switch role="group" aria-label={locale === 'pt' ? 'Idioma do site' : 'Website language'}>
      <a href={localePath(Astro.url.pathname, 'en')} hreflang="en" lang="en" aria-label="Read this page in English" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href={localePath(Astro.url.pathname, 'pt')} hreflang="pt-BR" lang="pt-BR" aria-label="Ler esta página em português" aria-current={locale === 'pt' ? 'true' : undefined}>PT</a>
    </div>
  </div>
</header>
<style>
  .language-switch { display: flex; align-items: center; flex-shrink: 0; gap: .15rem; font: .7rem ui-monospace, monospace; }
  .language-switch a { display: grid; place-items: center; min-height: 44px; min-width: 32px; color: var(--ink-muted); }
  .language-switch a[aria-current] { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; }
  .language-switch span { color: var(--ink-muted); }
  @media(max-width: 1100px) {
    :global(.header-inner) { min-height: 76px; flex-wrap: wrap; gap: .5rem; }
    :global(.site-brand) { margin-right: auto; }
    .language-switch { order: 1; }
    :global(.nav-toggle) { order: 2; padding-inline: .7rem; font-size: .8rem; }
    :global(.nav-toggle span) { display: none; }
    :global(.nav-ready .nav-toggle) { display: block; }
    :global(#primary-nav) { order: 3; width: 100%; padding-block: .75rem 1rem; flex-wrap: wrap; gap: .5rem 1.5rem; }
    :global(.nav-ready #primary-nav) { display: none; }
    :global(.nav-ready #primary-nav.is-open) { display: grid; grid-template-columns: repeat(2, 1fr); }
  }
  @media(max-width: 360px) { :global(.brand-name) { display: none; } }
</style>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-language-switch] a').forEach((link) => {
    link.addEventListener('click', () => { link.hash = window.location.hash; });
  });
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  if (toggle && nav) {
    document.documentElement.classList.add('nav-ready');
    const close = () => { toggle.setAttribute('aria-expanded', 'false'); nav.classList.remove('is-open'); };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open)); nav.classList.toggle('is-open', open);
    });
    nav.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) close(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && nav.classList.contains('is-open')) { close(); toggle.focus(); } });
    window.matchMedia('(min-width: 1101px)').addEventListener('change', close);
  }
</script>
