---
interface Props { eyebrow: string; title: string; text?: string; level?: 'h1' | 'h2'; }
const { eyebrow, title, text, level = 'h2' } = Astro.props;
const Heading = level;
---
<div class="max-w-3xl">
  <p class="kicker">{eyebrow}</p>
  <Heading class="mt-3 font-serif text-[clamp(2rem,3.8vw,3.4rem)] leading-[1.12] text-ink-900">{title}</Heading>
  {text && <p class="mt-5 text-base md:text-lg leading-8 text-ink-600">{text}</p>}
</div>
