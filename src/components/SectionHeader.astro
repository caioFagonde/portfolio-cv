---
const { eyebrow, title, text } = Astro.props;
---
<div class="max-w-3xl">
  <p class="kicker">{eyebrow}</p>
  <h2 class="mt-3 font-serif text-4xl md:text-6xl leading-[0.94] tracking-[-0.06em] text-ink-900">{title}</h2>
  {text && <p class="mt-5 text-base md:text-lg leading-8 text-ink-600">{text}</p>}
</div>
