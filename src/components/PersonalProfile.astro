---
import { personalSkillGroups, spokenLanguages } from '@/data/cv';
---
<section class="personal-profile" aria-labelledby="personal-profile-title">
  <header>
    <p class="kicker">People, languages & music</p>
    <h2 id="personal-profile-title">A little more about me.</h2>
  </header>
  <div class="personal-profile-columns">
    {personalSkillGroups.map((group) => (
      <section id={group.id}>
        <h3>{group.title}</h3>
        <p>{group.description}</p>
        <ul>{group.skills.map((skill) => <li>{skill}</li>)}</ul>
      </section>
    ))}
    <section id="spoken-languages">
      <h3>Spoken languages</h3>
      <dl>{spokenLanguages.map(({ name, level }) => <div><dt>{name}</dt><dd>{level}</dd></div>)}</dl>
    </section>
  </div>
</section>
<style>
  .personal-profile { padding-block: 3rem; border-top: 1px solid var(--line); }
  .personal-profile h2 { font: clamp(2rem, 3.8vw, 3.4rem)/1.12 Georgia, serif; margin-top: .75rem; }
  .personal-profile-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; margin-top: 2rem; }
  .personal-profile-columns > section { border-top: 1px solid var(--line); padding-top: 1rem; scroll-margin-top: 6rem; }
  .personal-profile h3 { font: 1.5rem/1.25 Georgia, serif; }
  .personal-profile-columns p { margin-top: .75rem; font-size: .9rem; line-height: 1.75; color: var(--ink-muted); }
  .personal-profile ul { display: flex; flex-wrap: wrap; gap: .6rem 1.25rem; margin-top: 1rem; font-size: .9rem; }
  .personal-profile dl { margin-top: .75rem; font-size: .9rem; }
  .personal-profile dl > div { display: flex; justify-content: space-between; gap: 1rem; padding-block: .55rem; border-bottom: 1px solid var(--line); }
  .personal-profile dd { color: var(--ink-muted); }
  @media(max-width: 750px) { .personal-profile-columns { grid-template-columns: 1fr; gap: 2rem; } }
</style>
