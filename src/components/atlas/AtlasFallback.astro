---
import { domains } from '@/data/domains';
---
<div class="atlas-card p-5">
  <p class="kicker">Research atlas</p>
  <h3 class="mt-3 font-serif text-3xl leading-[0.98] text-ink-900">A compact map of the work.</h3>
  <div class="mt-5 grid gap-2 sm:grid-cols-2">
    {domains.map((domain) => (
      <div class="border hairline bg-paper-50/70 p-3.5">
        <h4 class="font-serif text-xl">{domain.title}</h4>
        <p class="mt-1.5 text-sm leading-6 text-ink-600">{domain.short}</p>
        <div class="mt-2.5 flex flex-wrap gap-1.5">
          {domain.stages.map((stage) => <span class="bg-paper-100 px-2 py-0.5 font-mono text-[0.50rem] uppercase tracking-[0.11em] text-ink-600">{stage}</span>)}
        </div>
      </div>
    ))}
  </div>
</div>
