---
import { sitePath } from '@/utils/paths';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SkillsMap from '@/components/SkillsMap.astro';
---
<BaseLayout title="Skills — Caio Nahuel" description="An interactive map of development, cloud, AI, science, leadership, music, and spoken languages.">
  <section class="container-atlas page-intro"><p class="kicker">Skills & connections</p><h1>Skills, tools<br /><span class="hero-emphasis">& interests.</span></h1><p class="intro">Software development, cloud infrastructure, AI agents, and chatbots are at the center of my work. Explore the map for my scientific background, leadership and management skills, music, and spoken languages.</p></section>
  <section class="container-atlas pb-16"><SkillsMap branchLevel="h2" /><div class="hero-actions"><a class="btn-primary" href={sitePath('/contact')}>Talk about a project</a><a class="btn-secondary" href={sitePath('/projects')}>See the projects</a></div></section>
</BaseLayout>
