---
import { sitePath } from '@/utils/paths';
import { profile } from '@/data/cv';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { consultingServices } from '@/data/services';
---
<BaseLayout
  title="Consulting — Caio Nahuel"
  description="Software development, cloud infrastructure, AI agents, chatbots, automation, and technical consulting."
>
  <section class="container-atlas py-14 md:py-20">
    <div class="grid gap-10 border-b hairline pb-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
      <div>
        <p class="kicker">Consulting</p>
        <h1 class="mt-5 max-w-[12em] font-serif text-[clamp(3rem,6.4vw,5.8rem)] leading-[0.95] text-ink-900 text-balance">
          Software, cloud<br />& AI systems.
        </h1>
      </div>
      <div class="max-w-xl lg:justify-self-end">
        <p class="text-lg leading-8 text-ink-700">
          I develop applications, backend services, AI agents, and chatbots. I also set up cloud infrastructure, automate engineering tasks, and review existing codebases.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn-primary" href={sitePath(`mailto:${profile.email}?subject=Technical%20build%20or%20repo%20review`)}>Discuss a technical build</a>
          <a class="btn-secondary" href="#services">Review services</a>
          <a class="btn-tertiary" href={sitePath('/repo-audit')}>Request a repo audit</a>
        </div>
      </div>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {[
        ['Build', 'A new application, assistant, API, or integration.'],
        ['Deploy', 'Cloud environments, containers, databases, and background workers.'],
        ['Improve', 'An existing codebase, deployment, or development workflow.']
      ].map(([label, text]) => (
        <div class="border-l hairline pl-4">
          <p class="kicker">{label}</p>
          <p class="mt-3 text-sm leading-7 text-ink-700">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="services" class="container-atlas py-10 md:py-14">
    <SectionHeader
        eyebrow="Services"
      title="How I can help."
      text="Choose an area below, or email me about the project you have in mind."
    />

    <div class="mt-10 grid gap-6">
      {consultingServices.map((service, index) => (
        <article id={service.slug} class="service-detail scroll-mt-28 py-8 md:py-10">
          <div class="grid gap-8 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
            <div>
              <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-copper-700">0{index + 1} · service</p>
              <h2 class="mt-4 font-serif text-[clamp(2rem,4vw,3.6rem)] leading-[1.02] text-ink-900">{service.title}</h2>
              <p class="mt-4 text-base leading-8 text-ink-700">{service.summary}</p>
              <a class="btn-secondary mt-6" href={sitePath(service.detailUrl ?? `mailto:${profile.email}?subject=${encodeURIComponent(service.title)}`)}>{service.cta}</a>
            </div>

            <div class="grid gap-5">
              <div class="grid gap-4 md:grid-cols-[0.7fr_1.3fr]">
                <h3 class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-600">Problem</h3>
                <p class="text-sm leading-7 text-ink-700">{service.problem}</p>
              </div>
              <div class="grid gap-4 border-t hairline pt-5 md:grid-cols-[0.7fr_1.3fr]">
                <h3 class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-600">What I do</h3>
                <ul class="grid gap-2 text-sm leading-7 text-ink-700">
                  {service.whatIDo.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div class="grid gap-4 border-t hairline pt-5 md:grid-cols-[0.7fr_1.3fr]">
                <h3 class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ink-600">Deliverables</h3>
                <div class="flex flex-wrap gap-2">
                  {service.deliverables.map((item) => <span class="meta-pill">{item}</span>)}
                </div>
              </div>

            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-rule py-14">
    <div class="container-atlas grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <SectionHeader
        eyebrow="Engagement style"
        title="How we work together."
        text="We agree on what to build, work through it in small steps, and test it in the environment where it will run."
      />
      <div class="grid gap-4 md:grid-cols-2">
        {[
          ['First conversation', 'Talk through the users, existing code, integrations, and timeline.'],
          ['Development', 'Build and review changes in small increments.'],
          ['Testing', 'Check the main flows, errors, accessibility, and deployment.'],
          ['Documentation', 'Explain how to run, deploy, and maintain the system.']
        ].map(([title, text]) => (
          <div class="border-t hairline pt-4">
            <h3 class="font-serif text-2xl leading-tight text-ink-900">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-ink-700">{text}</p>
          </div>
        ))}
      </div>
      <div class="lg:col-start-2">
        <div class="mt-2 flex flex-wrap gap-3">
          <a class="btn-secondary" href={sitePath('/workflow')}>See the engineering workflow</a>
          <a class="btn-tertiary" href={sitePath('/downloads/agent-qa-checklist.md')}>Download QA checklist</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
