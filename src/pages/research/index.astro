---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getCollection } from 'astro:content';
const essays = (await getCollection('essays')).filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection('notes')).filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Research — Systems Atlas" description="Essays, notes, and paper maps across aerospace, geospatial intelligence, computer vision, and agentic systems.">
  <section class="container-atlas py-14 md:py-20">
    <SectionHeader eyebrow="Research log" title="A structured notebook for ideas that are still moving." text="Notes are allowed to be provisional, but they must stay grounded: what is known, what is speculative, and what should be tested next." />
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {[...essays, ...notes].map((entry) => (
        <a href={`/research/${entry.slug}`} class="atlas-card block p-6 hover:border-copper-500/40">
          <p class="kicker">{entry.collection} · {entry.data.date.toLocaleDateString('en-US')}</p>
          <h3 class="mt-4 font-serif text-3xl leading-none tracking-[-0.05em]">{entry.data.title}</h3>
          <p class="mt-4 text-sm leading-7 text-ink-600">{entry.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
