---
import { sitePath } from '@/utils/paths';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { getCollection } from 'astro:content';
const essays = (await getCollection('essays')).filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const notes = (await getCollection('notes')).filter((e) => !e.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const entries = [...essays, ...notes].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Research — Systems Atlas" description="Essays, notes, and paper maps across aerospace, geospatial intelligence, computer vision, and agentic systems.">
  <section class="container-atlas py-14 md:py-20">
    <SectionHeader level="h1" eyebrow="Research log" title="Notes on software and science." text="Document retrieval, numerical methods, orbital simulation, and other technical subjects I work on." />
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {entries.map((entry) => (
        <a href={sitePath(`/research/${entry.slug}`)} class="atlas-card block p-6 hover:border-copper-500/40">
          <p class="kicker">{entry.collection} · <time datetime={entry.data.date.toISOString().slice(0, 10)}>{entry.data.date.toLocaleDateString('en-US', { timeZone: 'UTC' })}</time></p>
          <h2 class="mt-4 font-serif text-3xl leading-none">{entry.data.title}</h2>
          <p class="mt-4 text-sm leading-7 text-ink-600">{entry.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
