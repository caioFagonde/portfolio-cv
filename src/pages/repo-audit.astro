---
import { sitePath } from '@/utils/paths';
import { profile } from '@/data/cv';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { auditAreas } from '@/data/workflow';

const deliverables = [
  'Repository map with ownership, framework, routing, scripts, and deployment assumptions.',
  'Risk map across runtime behavior, visual quality, API/backend readiness, testing, and AI-agent workflow.',
  'Verification matrix for lint, typecheck, tests, build, screenshots, accessibility, and backend/API checks where applicable.',
  'Visual QA findings with screenshots and prioritized fixes.',
  'AI-agent readiness plan with repo instructions, no-blind-coding rules, handoff requirements, and CI gate recommendations.',
  'Prioritized remediation list grouped by immediate fixes, leverage work, and longer-term cleanup.'
];

const fit = [
  'A real repo or prototype already exists.',
  'The team wants AI-assisted delivery but needs stronger guardrails.',
  'Runtime behavior, mobile UI, API boundaries, or deployment risk feel unclear.',
  'You want an outside technical read before a build, refactor, or agent rollout.'
];

const notFit = [
  'A formal security, compliance, or penetration test unless scoped separately.',
  'A replacement for production incident response.',
  'A speculative strategy deck with no repository, route, or workflow to inspect.',
  'A promise to rewrite the codebase before the actual risks are mapped.'
];
---
<BaseLayout
  title="Repo Audit - Caio Nahuel"
  description="A repo audit for AI-assisted delivery, runtime risk, verification coverage, visual QA, backend/API readiness, and implementation leverage."
>
  <section class="container-atlas py-14 md:py-20">
    <div class="grid gap-10 border-b hairline pb-12 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <div>
        <p class="kicker">Repo audit</p>
        <h1 class="mt-5 max-w-[12em] font-serif text-[clamp(3rem,6.2vw,5.75rem)] leading-[0.95] text-ink-900 text-balance">
          Know the shape of your codebase.
        </h1>
      </div>
      <div class="max-w-xl lg:justify-self-end">
        <p class="text-lg leading-8 text-ink-700">
          This is a focused technical review for teams that need to know what to fix first: repo shape, routes, UI behavior, tests, APIs, deployment assumptions, and whether coding agents can work safely inside the project.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn-primary" href={sitePath(`mailto:${profile.email}?subject=Repo%20audit%20request`)}>Request a repo audit</a>
          <a class="btn-secondary" href={sitePath('/downloads/repo-audit-checklist.md')}>Download checklist</a>
          <a class="btn-tertiary" href={sitePath('/workflow')}>See workflow</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-atlas pb-16 md:pb-24">
    <SectionHeader
      eyebrow="Audit areas"
      title="What gets checked."
      text="The review combines code reading with runtime inspection. A repo audit that never runs the product usually misses the expensive problems."
    />
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {auditAreas.map((area, index) => (
        <article class="atlas-card p-6">
          <p class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-copper-700">0{index + 1} · area</p>
          <h2 class="mt-4 font-serif text-3xl leading-[1.03] text-ink-900">{area.title}</h2>
          <ul class="mt-5 grid gap-2 text-sm leading-7 text-ink-700">
            {area.checks.map((check) => (
              <li class="grid grid-cols-[0.55rem_1fr] gap-3">
                <span class="mt-3 h-1.5 w-1.5 bg-copper-600"></span>
                <span>{check}</span>
              </li>
            ))}
          </ul>
          <div class="mt-5 border-t hairline pt-4">
            <p class="kicker">Output</p>
            <p class="mt-3 text-sm leading-7 text-ink-700">{area.output}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-rule py-14 md:py-20">
    <div class="container-atlas grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:items-start">
      <SectionHeader
        eyebrow="Deliverables"
        title="The output should be useful after the call ends."
        text="The audit is not a generic scorecard. It should produce a working map of what is risky, what is already fine, and what gives the team the most leverage."
      />
      <div class="grid gap-3">
        {deliverables.map((item, index) => (
          <div class="grid gap-4 border-t hairline py-4 md:grid-cols-[auto_1fr]">
            <span class="font-mono text-[0.62rem] uppercase tracking-[0.12em] text-copper-700">0{index + 1}</span>
            <p class="text-sm leading-7 text-ink-700">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-atlas py-16 md:py-24">
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="atlas-card p-6 md:p-8">
        <p class="kicker">Good fit</p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.02] text-ink-900">Use it when the repo already has shape.</h2>
        <ul class="mt-6 grid gap-3 text-sm leading-7 text-ink-700">
          {fit.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="atlas-card p-6 md:p-8">
        <p class="kicker">Not a fit</p>
        <h2 class="mt-4 font-serif text-4xl leading-[1.02] text-ink-900">Do not use it as a vague discovery substitute.</h2>
        <ul class="mt-6 grid gap-3 text-sm leading-7 text-ink-700">
          {notFit.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
    <p class="mt-6 max-w-3xl text-sm leading-7 text-ink-600">
      Security, privacy, regulatory, and compliance reviews can be scoped as separate work. This audit is primarily about implementation leverage, runtime quality, verification coverage, and AI-agent readiness.
    </p>
  </section>

  <section class="section-rule py-14">
    <div class="container-atlas grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <p class="kicker">Request context</p>
        <h2 class="mt-3 max-w-3xl font-serif text-4xl leading-[1.02] text-ink-900 md:text-5xl">Send the repo shape, the current risk, and what decision the audit needs to support.</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-ink-700">Useful context: framework, deployment target, important routes, existing tests, backend/API surface, AI tools in use, timeline, and data sensitivity.</p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a class="btn-primary" href={sitePath(`mailto:${profile.email}?subject=Repo%20audit%20request`)}>Request a repo audit</a>
        <a class="btn-secondary" href={sitePath('/contact')}>Contact details</a>
      </div>
    </div>
  </section>
</BaseLayout>
