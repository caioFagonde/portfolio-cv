---
import { sitePath } from '@/utils/paths';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { projects } from '@/data/projects';
import ProjectGallery from '@/components/ProjectGallery.astro';
import ProjectFlow from '@/components/ProjectFlow.astro';
import DocumentExample from '@/components/DocumentExample.astro';
import SpatialExample from '@/components/SpatialExample.astro';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<BaseLayout title={`${project.title} — Project`} description={project.description}>
  <article class="container-atlas py-14 md:py-20">
    <a href={sitePath('/projects')} class="kicker hover:text-copper-500">&lt;- Projects</a>

    <header class="mt-10 grid gap-10 border-b hairline pb-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-end">
      <div>
        <div class="flex flex-wrap gap-2">
          <span class="meta-pill">{project.category}</span>
          <span class="meta-pill">{project.year}</span>
        </div>
        <h1 class="mt-5 max-w-[12em] font-serif text-[clamp(3rem,6.2vw,5.8rem)] leading-[0.95] text-ink-900 text-balance">{project.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-ink-700">{project.longDescription}</p>
      </div>

      <aside class="atlas-card p-6">
        <p class="kicker">Project metadata</p>
        <dl class="mt-5 grid gap-4 text-sm">
          <div>
            <dt class="text-ink-600">Stack</dt>
            <dd class="mt-2 flex flex-wrap gap-2">{project.stack.map((item) => <span class="meta-pill">{item}</span>)}</dd>
          </div>
          <div>
            <dt class="text-ink-600">Tags</dt>
            <dd class="mt-2 flex flex-wrap gap-2">{project.tags.map((item) => <span class="meta-pill">{item}</span>)}</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3 border-t hairline pt-5">
          {project.liveDemoUrl && <a class="btn-primary" href={sitePath(project.liveDemoUrl)}>Open demo</a>}
          {project.repositoryUrl && <a class="btn-secondary" href={sitePath(project.repositoryUrl)} target="_blank" rel="noreferrer">Repository</a>}
          {project.caseStudyUrl && <a class="btn-secondary" href={sitePath(project.caseStudyUrl)}>Case study</a>}
        </div>
      </aside>
    </header>

    <ProjectGallery slug={project.slug} />
    {project.slug === 'geodocs-document-assistant' && <DocumentExample />}
    {project.slug === 'hasselt-infill-atlas' && <SpatialExample kind="map" />}
    {project.slug === 'lidar-webgl-client' && <SpatialExample kind="cloud" />}
    <ProjectFlow project={project} />

    <div class="mt-12 grid gap-10 lg:grid-cols-[0.76fr_1.24fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="kicker">What this demonstrates</p>
        <ul class="mt-5 grid gap-3">
          {project.demonstrates.map((item) => (
            <li class="border-t hairline pt-3 text-sm leading-7 text-ink-700">{item}</li>
          ))}
        </ul>
      </div>

      <div class="grid gap-10">
        <section>
          <h2 class="font-serif text-4xl leading-tight text-ink-900">Problem</h2>
          <p class="mt-4 text-base leading-8 text-ink-700">{project.problem}</p>
        </section>

        <section>
          <h2 class="font-serif text-4xl leading-tight text-ink-900">Technical approach</h2>
          <div class="mt-5 grid gap-3">
            {project.technicalApproach.map((item) => (
              <p class="border-t hairline pt-3 text-sm leading-7 text-ink-700">{item}</p>
            ))}
          </div>
        </section>

        <section>
          <div>
            <h2 class="font-serif text-3xl leading-tight text-ink-900">Lessons learned</h2>
            <ul class="mt-5 grid gap-3 text-sm leading-7 text-ink-700">
              {project.lessonsLearned.map((item) => <li class="border-t hairline pt-3">{item}</li>)}
            </ul>
          </div>

        </section>


      </div>
    </div>
  </article>
</BaseLayout>
