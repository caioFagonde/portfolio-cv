---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CaseCard from '@/components/CaseCard.astro';
import { getCollection } from 'astro:content';
const cases = (await getCollection('cases')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Cases — Systems Atlas" description="Technical case studies and research programmes by Caio Nahuel.">
  <section class="container-atlas py-14 md:py-20">
    <SectionHeader level="h1" eyebrow="Cases" title="Engineering case studies." text="Architecture, methods, and design decisions from my projects." />
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {cases.map((entry) => <CaseCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
