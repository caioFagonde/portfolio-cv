---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} — Systems Atlas`} description={frontmatter.summary}>
  <article class="container-atlas py-14 md:py-20">
    <a href="/research" class="kicker hover:text-copper-500">← Research</a>
    <header class="mt-10 max-w-3xl border-b hairline pb-10">
      <p class="kicker">{frontmatter.date?.toLocaleDateString?.('en-US') ?? ''}</p>
      <h1 class="mt-4 font-serif text-5xl md:text-7xl leading-[0.93] tracking-[-0.06em] text-ink-900">{frontmatter.title}</h1>
      <p class="mt-6 text-lg leading-8 text-ink-600">{frontmatter.summary}</p>
    </header>
    <div class="prose-atlas mt-12 max-w-3xl"><slot /></div>
  </article>
</BaseLayout>
